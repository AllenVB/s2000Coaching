# Copy to deploy/.env and fill in. This file holds secrets: it is ignored by git and should be
# readable by you only (chmod 600 deploy/.env). Never paste its contents into a chat or e-mail.

# --- Address ---------------------------------------------------------------
# The domain visitors type, without https://. Its DNS A record must point at this server.
SITE_ADDRESS=ornek.com
# The same address with https://. Used in e-mails and as the allowed origin.
PUBLIC_URL=https://ornek.com
# Defaults are 80 and 443. Change only for a trial on a machine where they are taken.
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Database --------------------------------------------------------------
# Long and random, e.g. the output of:  openssl rand -base64 24
DB_PASSWORD=

# --- First coach account ---------------------------------------------------
# Used once, to create the account on an empty database. After the first login change the
# password under Ayarlar, then delete ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Koç

# --- Time ------------------------------------------------------------------
# Which day "today" is. Keep in step with the front end (it is built with the same value).
APP_TIME_ZONE=Europe/Istanbul

# --- E-mail ----------------------------------------------------------------
# Required: members sign in with a code sent by e-mail. Without SMTP the code is only written to
# the server log and no member can log in. Take these from your mail provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# 587 uses STARTTLS (the defaults). For port 465 set MAIL_SSL=true and MAIL_STARTTLS=false.
#MAIL_STARTTLS=true
#MAIL_SSL=false

# --- Payments --------------------------------------------------------------
# Bank transfer: shown to the member at checkout. Leave all three empty to switch it off.
PAYMENT_IBAN=
PAYMENT_IBAN_HOLDER=
PAYMENT_IBAN_BANK=
# Card payments (iyzico). Leave the keys empty to switch cards off. Start with the sandbox
# address and sandbox keys, make a test payment, and only then move to the live address.
PAYMENT_IYZICO_API_KEY=
PAYMENT_IYZICO_SECRET_KEY=
PAYMENT_IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Must be this exact shape, on your own domain:
PAYMENT_IYZICO_CALLBACK_URL=https://ornek.com/api/payments/iyzico/callback

# --- Backups ---------------------------------------------------------------
# Where backup.sh writes, and how many days it keeps.
#BACKUP_DIR=/var/backups/s2000
#BACKUP_KEEP_DAYS=14
